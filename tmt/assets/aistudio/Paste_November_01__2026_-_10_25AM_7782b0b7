## 5. Deliverable 1: Database Schema (Prisma ORM)

```prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum QuestionType {
  SCQ
  MCQ
  TRUE_FALSE
  FILL_BLANKS
  SUBJECTIVE
  CODING
}

enum SectionNavMode {
  FREE
  SEQUENTIAL
}

enum AttemptStatus {
  INITIALIZED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  TERMINATED_MALPRACTICE
}

enum QuestionStatus {
  UNVISITED
  UNANSWERED
  ANSWERED
  MARKED_FOR_REVIEW
  ANSWERED_AND_MARKED_FOR_REVIEW
}

model Organization {
  id             String         @id @default(uuid())
  slug           String         @unique
  name           String
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String         @default("#2563EB")
  secondaryColor String         @default("#1E40AF")
  fontFamily     String         @default("Inter")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tests          Test[]
  users          User[]

  @@map("organizations")
}

model User {
  id             String         @id @default(uuid())
  orgId          String
  email          String         @unique
  fullName       String
  role           String         @default("EVALUATOR") // TENANT_ADMIN, EVALUATOR
  organization   Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testsCreated   Test[]         @relation("AuthorTests")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("users")
}

model Test {
  id               String             @id @default(uuid())
  orgId            String
  authorId         String
  title            String
  description      String?
  guidelines       String             @db.Text
  totalDurationMin Int
  passPercentage   Float              @default(40.0)
  negativeMarking  Boolean            @default(false)
  navigationMode   SectionNavMode     @default(SEQUENTIAL)
  shuffleQuestions Boolean            @default(false)
  isPublished      Boolean            @default(false)
  organization     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author           User               @relation("AuthorTests", fields: [authorId], references: [id])
  sections         TestSection[]
  attempts         CandidateAttempt[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("tests")
}

model TestSection {
  id               String             @id @default(uuid())
  testId           String
  title            String             // e.g. "Technical Core", "Behavioral"
  description      String?
  orderIndex       Int
  durationMin      Int?               // Nullable if governed purely by global test timer
  totalMarks       Float              @default(0.0)
  test             Test               @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions        Question[]
  sectionAttempts  CandidateSectionAttempt[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([testId, orderIndex])
  @@map("test_sections")
}

model Question {
  id             String          @id @default(uuid())
  sectionId      String
  type           QuestionType
  content        String          @db.Text
  orderIndex     Int
  marks          Float           @default(1.0)
  negativeMarks  Float           @default(0.0)
  options        Json?           // Array: [{ id: "A", text: "...", isCorrect: true }]
  correctAnswers Json?           // Array or scalar: ["A"] or regex patterns for FILL_BLANKS
  codingMetadata Json?           // { language: "python", boilerplate: "...", testCases: [...] }
  section        TestSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses      CandidateResponse[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("questions")
}

model CandidateAttempt {
  id             String                  @id @default(uuid())
  testId         String
  candidateEmail String
  candidateName  String
  status         AttemptStatus           @default(INITIALIZED)
  startedAt      DateTime?
  submittedAt    DateTime?
  serverExpiresAt DateTime?
  totalScore     Float?
  clientIp       String?
  userAgent      String?
  test           Test                    @relation(fields: [testId], references: [id], onDelete: Cascade)
  sectionStates  CandidateSectionAttempt[]
  responses      CandidateResponse[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([testId, candidateEmail])
  @@map("candidate_attempts")
}

model CandidateSectionAttempt {
  id             String            @id @default(uuid())
  attemptId      String
  sectionId      String
  isUnlocked     Boolean           @default(false)
  isCompleted    Boolean           @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  attempt        CandidateAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section        TestSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
  @@map("candidate_section_attempts")
}

model CandidateResponse {
  id             String          @id @default(uuid())
  attemptId      String
  questionId     String
  status         QuestionStatus  @default(UNVISITED)
  savedAnswer    Json?           // Stores ["A"], "Text content", or code string
  timeSpentSec   Int             @default(0)
  scoreAwarded   Float?
  attempt        CandidateAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  updatedAt      DateTime        @updatedAt

  @@unique([attemptId, questionId])
  @@map("candidate_responses")
}

```

