### 8.3 Core Test Interface & Section Switcher (`TestWorkspace.tsx`)

```tsx
import React, { useState, useEffect } from "react";
import { useBrand } from "./ThemeProvider";
import { Bookmark, Clock, CheckCircle2, ChevronLeft, ChevronRight, AlertCircle } from "lucide-react";

export type QuestionStatusType = "UNVISITED" | "UNANSWERED" | "ANSWERED" | "MARKED_FOR_REVIEW";

export interface QuestionData {
  id: string;
  type: "SCQ" | "MCQ" | "TRUE_FALSE" | "FILL_BLANKS" | "SUBJECTIVE";
  content: string;
  marks: number;
  options?: Array<{ id: string; text: string }>;
}

export interface SectionData {
  id: string;
  title: string;
  durationSeconds: number;
  questions: QuestionData[];
}

export const TestWorkspace: React.FC<{
  sections: SectionData[];
  onTriggerReview: () => void;
  onAutosave: (questionId: string, answer: any, status: QuestionStatusType) => void;
}> = ({ sections, onTriggerReview, onAutosave }) => {
  const brand = useBrand();

  const [activeSecIdx, setActiveSecIdx] = useState(0);
  const [activeQIdx, setActiveQIdx] = useState(0);
  const [timeRemaining, setTimeRemaining] = useState(sections[0].durationSeconds);

  // Keyed by Question ID
  const [answers, setAnswers] = useState<Record<string, any>>({});
  const [statuses, setStatuses] = useState<Record<string, QuestionStatusType>>({});

  const currentSection = sections[activeSecIdx];
  const currentQuestion = currentSection.questions[activeQIdx];

  // Section-specific Countdown Timer
  useEffect(() => {
    const timer = setInterval(() => {
      setTimeRemaining((prev) => {
        if (prev <= 1) {
          clearInterval(timer);
          handleSectionAutoAdvance();
          return 0;
        }
        return prev - 1;
      });
    }, 1000);
    return () => clearInterval(timer);
  }, [activeSecIdx]);

  const handleSectionAutoAdvance = () => {
    if (activeSecIdx < sections.length - 1) {
      setActiveSecIdx((prev) => prev + 1);
      setActiveQIdx(0);
      setTimeRemaining(sections[activeSecIdx + 1].durationSeconds);
    } else {
      onTriggerReview();
    }
  };

  const handleSelectOption = (optId: string) => {
    const isSelected = answers[currentQuestion.id] === optId;
    const newAnswer = isSelected ? null : optId;
    const newStatus: QuestionStatusType = newAnswer ? "ANSWERED" : "UNANSWERED";

    setAnswers((prev) => ({ ...prev, [currentQuestion.id]: newAnswer }));
    setStatuses((prev) => ({ ...prev, [currentQuestion.id]: newStatus }));
    onAutosave(currentQuestion.id, newAnswer, newStatus);
  };

  const toggleMarkForReview = () => {
    const current = statuses[currentQuestion.id];
    const updated: QuestionStatusType = current === "MARKED_FOR_REVIEW" ? "ANSWERED" : "MARKED_FOR_REVIEW";
    setStatuses((prev) => ({ ...prev, [currentQuestion.id]: updated }));
    onAutosave(currentQuestion.id, answers[currentQuestion.id], updated);
  };

  const formatTimer = (sec: number) => {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
  };

  return (
    <div className="h-screen flex flex-col bg-slate-100 overflow-hidden">
      {/* Top Application Bar */}
      <header className="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between shrink-0">
        <div className="flex items-center gap-6">
          <img src={brand.logoUrl} alt={brand.orgName} className="h-7 object-contain" />
          <div className="h-6 w-px bg-slate-200" />
          <nav className="flex items-center gap-1">
            {sections.map((sec, idx) => (
              <button
                key={sec.id}
                onClick={() => {
                  setActiveSecIdx(idx);
                  setActiveQIdx(0);
                  setTimeRemaining(sec.durationSeconds);
                }}
                className={`px-3 py-1.5 text-xs font-semibold rounded-md transition ${
                  activeSecIdx === idx
                    ? "bg-slate-900 text-white"
                    : "text-slate-600 hover:bg-slate-100"
                }`}
              >
                {sec.title}
              </button>
            ))}
          </nav>
        </div>

        {/* Synchronized Timer Display */}
        <div className="flex items-center gap-4">
          <div
            className={`flex items-center gap-2 px-3 py-1.5 rounded-lg border font-mono text-sm font-bold ${
              timeRemaining < 300
                ? "bg-red-50 border-red-200 text-red-600 animate-pulse"
                : "bg-slate-50 border-slate-200 text-slate-800"
            }`}
          >
            <Clock className="w-4 h-4" />
            <span>{formatTimer(timeRemaining)}</span>
          </div>

          <button
            onClick={onTriggerReview}
            className="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs rounded-md shadow-sm transition"
          >
            Review & Submit
          </button>
        </div>
      </header>

      {/* Workspace Body */}
      <div className="flex-1 flex overflow-hidden">
        {/* Main Interaction Canvas */}
        <main className="flex-1 p-8 flex flex-col justify-between overflow-y-auto">
          <div className="max-w-3xl w-full mx-auto bg-white border border-slate-200 rounded-xl p-8 shadow-sm">
            <div className="flex justify-between items-center mb-6 pb-4 border-b border-slate-100">
              <span className="text-xs font-bold uppercase tracking-wider text-slate-400">
                Question {activeQIdx + 1} of {currentSection.questions.length}
              </span>
              <span className="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-700 rounded">
                +{currentQuestion.marks} Marks
              </span>
            </div>

            <h2 className="text-lg font-medium text-slate-800 leading-relaxed mb-6">
              {currentQuestion.content}
            </h2>

            {/* Render Multiple Choice Radio / Options */}
            {currentQuestion.options && (
              <div className="space-y-3 mb-8">
                {currentQuestion.options.map((opt) => {
                  const isChecked = answers[currentQuestion.id] === opt.id;
                  return (
                    <div
                      key={opt.id}
                      onClick={() => handleSelectOption(opt.id)}
                      className={`flex items-center gap-4 p-4 border rounded-lg cursor-pointer transition ${
                        isChecked
                          ? "border-blue-600 bg-blue-50/50"
                          : "border-slate-200 hover:bg-slate-50"
                      }`}
                    >
                      <div
                        className={`w-5 h-5 rounded-full border flex items-center justify-center text-xs font-bold ${
                          isChecked
                            ? "border-blue-600 bg-blue-600 text-white"
                            : "border-slate-300 text-slate-600"
                        }`}
                      >
                        {opt.id}
                      </div>
                      <span className="text-sm font-normal text-slate-700">{opt.text}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          {/* Bottom Step Actions */}
          <div className="max-w-3xl w-full mx-auto flex items-center justify-between pt-6">
            <button
              onClick={toggleMarkForReview}
              className={`flex items-center gap-2 px-4 py-2 border rounded-lg text-xs font-medium transition ${
                statuses[currentQuestion.id] === "MARKED_FOR_REVIEW"
                  ? "bg-purple-50 border-purple-300 text-purple-700"
                  : "bg-white border-slate-200 text-slate-600 hover:bg-slate-50"
              }`}
            >
              <Bookmark className="w-4 h-4" />
              {statuses[currentQuestion.id] === "MARKED_FOR_REVIEW"
                ? "Flagged for Review"
                : "Mark for Review"}
            </button>

            <div className="flex items-center gap-3">
              <button
                disabled={activeQIdx === 0}
                onClick={() => setActiveQIdx((prev) => prev - 1)}
                className="flex items-center gap-1.5 px-4 py-2 bg-white border border-slate-200 rounded-lg text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40"
              >
                <ChevronLeft className="w-4 h-4" /> Previous
              </button>
              <button
                disabled={activeQIdx === currentSection.questions.length - 1}
                onClick={() => setActiveQIdx((prev) => prev + 1)}
                className="flex items-center gap-1.5 px-4 py-2 bg-slate-900 text-white rounded-lg text-xs font-medium hover:bg-slate-800 disabled:opacity-40"
              >
                Next <ChevronRight className="w-4 h-4" />
              </button>
            </div>
          </div>
        </main>

        {/* Right Palette Grid Drawer */}
        <aside className="w-80 bg-white border-l border-slate-200 p-6 flex flex-col justify-between shrink-0">
          <div>
            <h3 className="text-sm font-bold text-slate-800 uppercase tracking-wide mb-4">
              Question Palette
            </h3>
            <div className="grid grid-cols-5 gap-2.5 mb-6">
              {currentSection.questions.map((q, idx) => {
                const st = statuses[q.id] || "UNVISITED";
                let style = "bg-slate-100 text-slate-600 border-slate-200";

                if (st === "ANSWERED") style = "bg-blue-600 text-white border-blue-600";
                if (st === "MARKED_FOR_REVIEW")
                  style = "bg-purple-600 text-white border-purple-600";
                if (activeQIdx === idx) style += " ring-2 ring-slate-900 ring-offset-2";

                return (
                  <button
                    key={q.id}
                    onClick={() => setActiveQIdx(idx)}
                    className={`h-9 rounded-lg border text-xs font-bold flex items-center justify-center transition ${style}`}
                  >
                    {idx + 1}
                  </button>
                );
              })}
            </div>
          </div>

          {/* Palette Legend */}
          <div className="border-t border-slate-100 pt-4 space-y-2 text-xs">
            <div className="flex items-center gap-2 text-slate-600">
              <span className="w-3 h-3 rounded bg-blue-600" /> Answered
            </div>
            <div className="flex items-center gap-2 text-slate-600">
              <span className="w-3 h-3 rounded bg-purple-600" /> Marked for Review
            </div>
            <div className="flex items-center gap-2 text-slate-600">
              <span className="w-3 h-3 rounded bg-slate-100 border border-slate-300" /> Unvisited
            </div>
          </div>
        </aside>
      </div>
    </div>
  );
};

