### 8.4 Pre-Submission Review & Edit Modal (`SubmissionReviewModal.tsx`)

```tsx
import React, { useState } from "react";
import { AlertCircle, ArrowLeft, CheckCircle2 } from "lucide-react";

interface QuestionSummary {
  id: string;
  orderIndex: number;
  sectionIndex: number;
  sectionTitle: string;
  status: "ANSWERED" | "UNANSWERED" | "MARKED_FOR_REVIEW" | "UNVISITED";
}

interface SubmissionReviewModalProps {
  isOpen: boolean;
  onClose: () => void;
  onJumpToQuestion: (sectionIndex: number, questionIndex: number) => void;
  onSubmitFinal: () => void;
  questionsSummary: QuestionSummary[];
}

export const SubmissionReviewModal: React.FC<SubmissionReviewModalProps> = ({
  isOpen,
  onClose,
  onJumpToQuestion,
  onSubmitFinal,
  questionsSummary,
}) => {
  const [doubleConfirm, setDoubleConfirm] = useState(false);

  if (!isOpen) return null;

  const totalAnswered = questionsSummary.filter((q) => q.status === "ANSWERED").length;
  const totalMarked = questionsSummary.filter((q) => q.status === "MARKED_FOR_REVIEW").length;
  const totalUnanswered = questionsSummary.length - totalAnswered;

  return (
    <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div className="bg-white max-w-3xl w-full rounded-2xl shadow-2xl border border-slate-100 overflow-hidden flex flex-col max-h-[90vh]">
        {/* Modal Header */}
        <div className="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h2 className="text-xl font-bold text-slate-900">Review Assessment Before Submission</h2>
            <p className="text-xs text-slate-500 mt-0.5">
              Verify your responses below. You may return to any unlocked question to adjust answers.
            </p>
          </div>
          <button
            onClick={onClose}
            className="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-50"
          >
            <ArrowLeft className="w-5 h-5" />
          </button>
        </div>

        {/* Aggregated Metric Cards */}
        <div className="grid grid-cols-3 gap-4 px-6 py-4 bg-slate-50 border-b border-slate-100">
          <div className="p-3 bg-white rounded-lg border border-slate-200">
            <span className="text-xs font-semibold text-slate-400 uppercase">Answered</span>
            <p className="text-xl font-bold text-emerald-600">{totalAnswered}</p>
          </div>
          <div className="p-3 bg-white rounded-lg border border-slate-200">
            <span className="text-xs font-semibold text-slate-400 uppercase">Unanswered</span>
            <p className="text-xl font-bold text-red-500">{totalUnanswered}</p>
          </div>
          <div className="p-3 bg-white rounded-lg border border-slate-200">
            <span className="text-xs font-semibold text-slate-400 uppercase">Flagged for Review</span>
            <p className="text-xl font-bold text-purple-600">{totalMarked}</p>
          </div>
        </div>

        {/* Question Inspection Grid */}
        <div className="p-6 overflow-y-auto space-y-3">
          <h3 className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
            Detailed Question Status
          </h3>
          <div className="grid grid-cols-6 sm:grid-cols-8 md:grid-cols-10 gap-2">
            {questionsSummary.map((q, idx) => {
              let badgeColor = "bg-slate-100 text-slate-600 border-slate-200";
              if (q.status === "ANSWERED") badgeColor = "bg-emerald-50 text-emerald-700 border-emerald-300";
              if (q.status === "MARKED_FOR_REVIEW")
                badgeColor = "bg-purple-50 text-purple-700 border-purple-300";
              if (q.status === "UNANSWERED") badgeColor = "bg-red-50 text-red-600 border-red-200";

              return (
                <button
                  key={q.id}
                  onClick={() => {
                    onClose();
                    onJumpToQuestion(q.sectionIndex, q.orderIndex);
                  }}
                  className={`h-10 rounded-lg border flex flex-col items-center justify-center hover:scale-105 transition cursor-pointer ${badgeColor}`}
                >
                  <span className="text-xs font-bold">{idx + 1}</span>
                </button>
              );
            })}
          </div>
        </div>

        {/* Double-Confirmation Submission Footer */}
        <div className="p-6 bg-slate-50 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div className="flex items-center gap-2">
            <input
              type="checkbox"
              id="confirmCheck"
              checked={doubleConfirm}
              onChange={(e) => setDoubleConfirm(e.target.checked)}
              className="w-4 h-4 accent-blue-600 rounded cursor-pointer"
            />
            <label htmlFor="confirmCheck" className="text-xs text-slate-600 select-none cursor-pointer">
              I am ready to finalize my test. I understand answers cannot be edited after this step.
            </label>
          </div>

          <div className="flex items-center gap-3 w-full sm:w-auto">
            <button
              onClick={onClose}
              className="flex-1 sm:flex-none px-4 py-2 border border-slate-200 bg-white rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-100"
            >
              Continue Test
            </button>
            <button
              disabled={!doubleConfirm}
              onClick={onSubmitFinal}
              className="flex-1 sm:flex-none px-6 py-2 bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 text-white rounded-lg text-xs font-semibold shadow-sm transition disabled:cursor-not-allowed cursor-pointer"
            >
              Submit Test Now
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

```